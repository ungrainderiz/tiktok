@@@ s01
@bg #050506
<style>
#s01-cam{position:absolute;inset:0}
#s01-card{left:60px;top:520px;width:960px;height:766px}
#s01-l1{left:0;right:0;top:200px;text-align:center;font-size:190px}
#s01-l2{left:0;right:0;top:390px;text-align:center;font-size:96px}
#s01-strike{left:300px;top:440px;width:480px}
#s01-l3{left:0;right:0;top:380px;text-align:center;font-size:120px}
</style>
<div class="bgfx"></div>
<div class="cam" id="s01-cam">
  <div class="persp"><div class="card" id="s01-card"><img src="assets/images/cases/trois-bulles.jpg" alt="Les trois bulles : sixième sens, étoile, quatre voies"><div class="shine"></div></div></div>
</div>
<div class="t red" id="s01-l1">3 peurs</div>
<div class="t" id="s01-l2">disparues</div>
<div class="strike" id="s01-strike"></div>
<div class="t red" id="s01-l3">revenues</div>
<div class="vig"></div>
@@@js
// raccord de boucle : la vidéo s'ouvre sur la case des trois bulles, exactement comme elle se termine
tl.fromTo("#s01-cam", { scale: 1 }, { scale: 1.0555, duration: 3.7, ease: "none", transformOrigin: "540px 903px" }, 0);
// Trois peurs qui avaient disparu de Chainsaw Man viennent de revenir.
flipIn("#s01-l1", W(0.15));
flipIn("#s01-l2", W(1.1));
strike("#s01-strike", W(2.6), 0.25);
tl.to("#s01-l2", { opacity: 0.35, duration: 0.2 }, W(2.6));
slamIn("#s01-l3", W(2.75));
tl.to(["#s01-l2", "#s01-strike"], { opacity: 0, duration: 0.15 }, W(2.75));
shake("#s01-card", W(2.8), 0.3, 10, 2);
// Et personne en parle. — tout sort vers le haut, la case plonge
flipOut("#s01-l1", 3.55); flipOut("#s01-l3", 3.6);
tl.to("#s01-cam", { scale: 1.5, opacity: 0, duration: 0.3, ease: "power2.in", immediateRender: false }, 3.7);

@@@ s02
@bg #050506
<style>
#s02-chip{left:356px;top:220px}
#s02-c1{left:290px;top:330px;width:500px;height:750px}
#s02-c2{left:240px;top:300px;width:600px;height:1002px}
#s02-c2 img{object-position:50% 40%}
#s02-lab{left:0;right:0;top:1120px;text-align:center;font-size:110px}
</style>
<div class="bgfx"></div>
<div class="chip" id="s02-chip">Rappel express</div>
<div class="persp"><div class="card" id="s02-c1"><img src="assets/images/cases/makima-kishibe.jpg" alt="Makima et Kishibe"><div class="shine"></div></div></div>
<div class="persp"><div class="card" id="s02-c2"><img src="assets/images/cases/chainsaw-pile.jpg" alt="Chainsaw Man sur une montagne de démons dévorés"><div class="shine"></div></div></div>
<div class="t red" id="s02-lab">dévorés</div>
<div class="vig"></div>
@@@js
// Rappel express.
fadeIn("#s02-chip", W(4.0), 0.2);
tl.fromTo("#s02-chip", { scale: 0.6 }, { scale: 1, duration: 0.35, ease: "back.out(2)" }, W(4.0));
// Makima l'a dit à Kishibe :
cardIn("#s02-c1", W(5.15), 10, -30, 0.6);
drift("#s02-c1", W(5.75), 1.1);
// Chainsaw Man a dévoré les nazis.
cardOut("#s02-c1", W(6.85), 35, 0.35);
fadeOut("#s02-chip", W(6.85), 0.2);
cardIn("#s02-c2", W(6.95), 8, 30, 0.6);
tl.fromTo("#s02-c2 img", { scale: 1.12 }, { scale: 1, duration: 1.3, ease: "power2.out" }, W(6.95));
slamIn("#s02-lab", W(7.8));
shake("#s02-c2", W(7.85), 0.3, 12, 3);
tl.to(["#s02-c2", "#s02-lab"], { opacity: 0, z: -600, duration: 0.25, ease: "power2.in" }, 3.95);

@@@ s03
@bg #050506
<style>
#s03-panel{left:90px;top:480px;width:900px;height:556px}
.row{position:absolute;left:110px;font-size:76px;white-space:nowrap}
.row b{font-family:"Inter";font-weight:900;font-size:34px;color:#ff2e2e;letter-spacing:4px;margin-right:22px;vertical-align:middle;text-shadow:none}
#s03-sweep{position:absolute;left:0;top:0;width:12px;height:1920px;background:#ff2e2e;box-shadow:0 0 40px #ff2e2e;opacity:0}
#s03-c2{left:80px;top:500px;width:920px;height:383px}
#s03-only{left:0;right:0;top:300px;text-align:center;font-size:120px}
#s03-only2{left:0;right:0;top:950px;text-align:center;font-size:96px}
</style>
<div class="bgfx"></div>
<div class="persp"><div class="card" id="s03-panel"><img src="assets/images/cases/liste.jpg" alt="Makima énumère tout ce que Chainsaw Man a dévoré"></div></div>
<div class="persp" id="s03-rows">
  <div class="t row" id="s03-r0"><b>01</b>les nazis</div>
  <div class="t row" id="s03-r1"><b>02</b>2e guerre mondiale</div>
  <div class="t row" id="s03-r2"><b>03</b>le sida</div>
  <div class="t row" id="s03-r3"><b>04</b>la SOA</div>
  <div class="t row" id="s03-r4"><b>05</b>syndrome d'Arnolone</div>
  <div class="t row" id="s03-r5"><b>06</b>éruption du mont Hio</div>
  <div class="t row" id="s03-r6"><b>07</b>armes nucléaires</div>
</div>
<div id="s03-sweep"></div>
<div class="persp"><div class="card" id="s03-c2"><img src="assets/images/cases/makima-devores.jpg" alt="Makima : parce que Chainsaw Man les a tous dévorés"><div class="shine"></div></div></div>
<div class="t" id="s03-only">elle seule</div>
<div class="t red" id="s03-only2">s'en souvient</div>
<div class="vig"></div>
@@@js
// … les nazis : la case de la liste, puis elle recule et sert de fond
cardIn("#s03-panel", 0.0, 8, -25, 0.5);
tl.to("#s03-panel", { z: -900, y: -120, opacity: 0.18, filter: "blur(3px)", duration: 0.7, ease: "power2.inOut" }, W(9.05));
// la liste s'écrit ligne par ligne, une ligne par mot prononcé
const rows = ["#s03-r0", "#s03-r1", "#s03-r2", "#s03-r3", "#s03-r4", "#s03-r5", "#s03-r6"];
const at = [8.45, 9.2, 10.8, 11.5, 12.2, 13.55, 14.95];
rows.forEach((r, i) => { gsap.set(r, { top: 250 + i * 112 }); flipIn(r, W(at[i]), 0.4); });
// Effacés du monde. — un trait rouge balaie la liste, les lignes se dissolvent
tl.fromTo("#s03-sweep", { x: -20, opacity: 1 }, { x: 1100, opacity: 1, duration: 0.55, ease: "power1.in", immediateRender: false }, W(16.1));
tl.set("#s03-sweep", { opacity: 0 }, W(16.1) + 0.56);
rows.forEach((r, i) => tl.to(r, { opacity: 0, x: 80, filter: "blur(14px)", duration: 0.3, ease: "power2.in" }, W(16.15) + i * 0.06));
tl.to("#s03-panel", { opacity: 0, duration: 0.3 }, W(16.4));
// Elle est la seule à s'en souvenir.
cardIn("#s03-c2", W(17.3), 10, 30, 0.6);
flipIn("#s03-only", W(17.45));
slamIn("#s03-only2", W(18.25));
tl.to(["#s03-c2", "#s03-only", "#s03-only2"], { opacity: 0, y: -60, duration: 0.3, ease: "power2.in" }, 11.1);

@@@ s04
@bg #050506
<style>
#s04-card{left:60px;top:520px;width:960px;height:766px}
#s04-kb{position:absolute;left:0;top:0;width:960px;height:766px}
#s04-kb img{position:absolute;left:0;top:0;width:960px;height:766px}
#s04-t1{left:0;right:0;top:200px;text-align:center;font-size:96px}
#s04-t2{left:0;right:0;top:320px;text-align:center;font-size:150px}
.lab{left:0;right:0;top:300px;text-align:center;font-size:150px}
.qc{position:absolute;top:560px;width:280px;height:400px;border-radius:26px;background:linear-gradient(160deg,#1d1b20,#0b0a0d);box-shadow:0 40px 80px #000000d0,0 0 0 2px #ffffff18}
.qc i{position:absolute;left:0;right:0;top:40px;text-align:center;font-family:"Anton";font-style:normal;font-size:220px;color:#ff2e2e;line-height:1;text-shadow:0 0 40px #ff2e2e66}
.qc b{position:absolute;left:0;right:0;bottom:30px;text-align:center;font-family:"Inter";font-weight:900;font-size:30px;letter-spacing:4px;color:#f4f1ee}
#s04-q0{left:80px}#s04-q1{left:400px}#s04-q2{left:720px}
#s04-m1{left:0;right:0;top:220px;text-align:center;font-size:96px}
#s04-m2{left:0;right:0;top:1060px;text-align:center;font-size:120px}
</style>
<div class="bgfx"></div>
<div class="persp"><div class="card" id="s04-card"><div id="s04-kb"><img src="assets/images/cases/trois-bulles.jpg" alt="Les trois bulles"></div><div class="shine"></div></div></div>
<div class="t" id="s04-t1">dans le lot</div>
<div class="t red" id="s04-t2">3 mystères</div>
<div class="t lab" id="s04-a">6e sens</div>
<div class="t red lab" id="s04-b">l'étoile</div>
<div class="t lab" id="s04-c">4 voies</div>
<div class="persp" id="s04-qs">
  <div class="qc" id="s04-q0"><i>?</i><b>6e SENS</b></div>
  <div class="qc" id="s04-q1"><i>?</i><b>L'ÉTOILE</b></div>
  <div class="qc" id="s04-q2"><i>?</i><b>4 VOIES</b></div>
</div>
<div class="t" id="s04-m1">jamais montrées</div>
<div class="t red" id="s04-m2">aucune image</div>
<div class="vig"></div>
@@@js
// Et dans le lot, y a trois trucs que personne a jamais expliqués.
cardIn("#s04-card", W(19.75), 10, -30, 0.7);
flipIn("#s04-t1", W(19.9));
slamIn("#s04-t2", W(20.7));
flipOut("#s04-t1", W(23.1)); flipOut("#s04-t2", W(23.15));
// la caméra va chercher chaque bulle quand elle est nommée (centre de la bulle → centre de la carte)
const clampv = (v, lo) => Math.min(0, Math.max(lo, v));  // jamais de bord vide autour de l'image
const kb = (bx, by, k) => ({ x: clampv(480 - bx * 1.0213 * k, 960 - 960 * k), y: clampv(383 - by * 1.0213 * k, 766 - 766 * k), scale: k });
gsap.set("#s04-kb", { transformOrigin: "0 0" });
tl.to("#s04-kb", { ...kb(756, 166, 2.1), duration: 0.6, ease: "power3.inOut" }, W(23.3));
flipIn("#s04-a", W(23.45));
tl.to("#s04-kb", { ...kb(446, 326, 2.1), duration: 0.6, ease: "power3.inOut" }, W(25.75));
flipOut("#s04-a", W(25.7));
flipIn("#s04-b", W(25.95));
tl.to("#s04-kb", { ...kb(171, 526, 2.1), duration: 0.6, ease: "power3.inOut" }, W(28.95));
flipOut("#s04-b", W(28.9));
flipIn("#s04-c", W(29.15));
tl.to("#s04-kb", { x: 0, y: 0, scale: 1, duration: 0.5, ease: "power3.inOut" }, W(31.4));
// Trois peurs tellement énormes que le manga nous a jamais montré à quoi elles ressemblaient.
flipOut("#s04-c", W(31.9));
cardOut("#s04-card", W(31.95), 35, 0.4);
["#s04-q0", "#s04-q1", "#s04-q2"].forEach((q, i) => {
  tl.fromTo(q, { rotationY: -100, z: -500, opacity: 0 }, { rotationY: (i - 1) * -14, z: i === 1 ? 60 : 0, opacity: 1, duration: 0.55, ease: "back.out(1.3)" }, W(32.06) + i * 0.25);
});
flipIn("#s04-m1", W(34.4));
slamIn("#s04-m2", W(35.0));
fadeOut(["#s04-m1", "#s04-m2"], 16.6, 0.2);

@@@ s05
@bg #050506
<style>
#s05-sweep{position:absolute;left:0;right:0;top:0;height:14px;background:#ff2e2e;box-shadow:0 0 40px #ff2e2e;opacity:0}
.qc{position:absolute;top:560px;width:280px;height:400px;border-radius:26px;background:linear-gradient(160deg,#1d1b20,#0b0a0d);box-shadow:0 40px 80px #000000d0,0 0 0 2px #ffffff18}
.qc i{position:absolute;left:0;right:0;top:40px;text-align:center;font-family:"Anton";font-style:normal;font-size:220px;color:#ff2e2e;line-height:1;text-shadow:0 0 40px #ff2e2e66}
.qc b{position:absolute;left:0;right:0;bottom:30px;text-align:center;font-family:"Inter";font-weight:900;font-size:30px;letter-spacing:4px;color:#f4f1ee}
#s05-q0{left:80px}#s05-q1{left:400px}#s05-q2{left:720px}
#s05-sauf{left:0;right:0;top:250px;text-align:center;font-size:150px}
#s05-card{left:250px;top:660px;width:580px;height:326px;background:url(assets/images/pochita-fin.jpg) center/cover}
#s05-p1{left:0;right:0;top:220px;text-align:center;font-size:150px}
#s05-p2{left:0;right:0;top:390px;text-align:center;font-size:110px}
#s05-u1{left:0;right:0;top:300px;text-align:center;font-size:96px}
#s05-u2{left:0;right:0;top:420px;text-align:center;font-size:80px}
#s05-flash{background:#fff}
</style>
<div class="bgfx"></div>
<div class="persp" id="s05-qs">
  <div class="qc" id="s05-q0"><i>?</i><b>6e SENS</b></div>
  <div class="qc" id="s05-q1"><i>?</i><b>L'ÉTOILE</b></div>
  <div class="qc" id="s05-q2"><i>?</i><b>4 VOIES</b></div>
</div>
<div id="s05-sweep"></div>
<div class="t red" id="s05-sauf">sauf que…</div>
<div class="persp" id="s05-persp"></div>
<div class="persp"><div class="card" id="s05-card"><video class="clip" src="assets/clips/pochita.mp4" data-start="1.2" data-duration="3.03" muted playsinline></video><div class="shine"></div></div></div>
<div class="t" id="s05-p1">pochita</div>
<div class="t red" id="s05-p2">s'est mangé</div>
<div class="t" id="s05-u1">« un univers où</div>
<div class="t red" id="s05-u2">je n'aurai jamais existé »</div>
<div class="flash" id="s05-flash"></div>
<div class="vig"></div>
@@@js
// les trois « ? » restent à l'écran (suite du plan précédent)
gsap.set("#s05-q0", { rotationY: 14 }); gsap.set("#s05-q1", { z: 60 }); gsap.set("#s05-q2", { rotationY: -14 });
// Sauf que… — tout se fige, trait rouge
tl.to("#s05-qs", { filter: "grayscale(1) brightness(0.45)", duration: 0.12 }, W(36.6));
tl.fromTo("#s05-sweep", { y: 300, opacity: 1 }, { y: 1500, opacity: 1, duration: 0.25, ease: "none", immediateRender: false }, W(36.6));
tl.set("#s05-sweep", { opacity: 0 }, W(36.6) + 0.26);
flipIn("#s05-sauf", W(36.7));
// Pochita s'est mangé lui-même. — rappel de la vidéo précédente : l'anneau-chaîne avale sa carte
tl.to("#s05-qs", { opacity: 0, z: -800, duration: 0.35, ease: "power2.in" }, W(37.4));
flipOut("#s05-sauf", W(37.45));
const R = ringBuild(document.getElementById("s05-persp"), "s05-ring");
gsap.set(R.tilt, { rotationX: 68 });
const sp = { a: 0 };
drive(0, 6.0, (t) => gsap.set(R.spin, { rotationZ: ((S0 + t) * RING_W + sp.a) % 360 }));
tl.fromTo(R.tilt, { opacity: 0, scale: 1.3 }, { opacity: 1, scale: 1, duration: 0.45, ease: "power3.out" }, W(37.55));
tl.fromTo("#s05-card", { y: 260, z: -500, rotationX: 70, opacity: 0, transformPerspective: 1600 }, { y: 0, z: 0, rotationX: 0, opacity: 1, duration: 0.45, ease: "power3.out" }, W(37.6));
flipIn("#s05-p1", W(37.7));
slamIn("#s05-p2", W(38.3));
tl.to(sp, { a: 540, duration: 1.2, ease: "power2.in" }, W(38.4));
tl.to("#s05-card", { y: 240, scale: 0.06, rotationZ: -360, opacity: 0, duration: 0.8, ease: "power3.in" }, W(38.6));
flipOut("#s05-p1", W(39.5)); flipOut("#s05-p2", W(39.55));
// « Un univers où je n'aurai jamais existé. » — flash, l'anneau disparaît
tl.fromTo("#s05-flash", { opacity: 0 }, { opacity: 0.85, duration: 0.05, yoyo: true, repeat: 1 }, W(39.6));
tl.to(R.tilt, { opacity: 0, scale: 1.4, duration: 0.25 }, W(39.62));
flipIn("#s05-u1", W(39.85));
slamIn("#s05-u2", W(40.8));
tl.to(["#s05-u1", "#s05-u2"], { opacity: 0, y: -40, duration: 0.25 }, 5.75);

@@@ s06
@bg #050506
<style>
#s06-card{left:80px;top:430px;width:920px;height:518px}
#s06-h1{left:0;right:0;top:230px;text-align:center;font-size:120px}
#s06-strike{left:150px;top:290px;width:780px}
#s06-none{left:0;right:0;top:1010px;text-align:center;font-size:96px}
.row2{position:absolute;left:0;right:0;text-align:center;font-size:64px}
.qc{position:absolute;top:760px;width:220px;height:300px;border-radius:22px;background:linear-gradient(160deg,#1d1b20,#0b0a0d);box-shadow:0 30px 60px #000000d0,0 0 0 2px #ffffff18}
.qc i{position:absolute;left:0;right:0;top:30px;text-align:center;font-family:"Anton";font-style:normal;font-size:160px;color:#ff2e2e;line-height:1;text-shadow:0 0 40px #ff2e2e66}
.qc b{position:absolute;left:0;right:0;bottom:22px;text-align:center;font-family:"Inter";font-weight:900;font-size:24px;letter-spacing:3px;color:#f4f1ee}
#s06-q0{left:150px}#s06-q1{left:430px}#s06-q2{left:710px}
#s06-all-t{left:0;right:0;top:1120px;text-align:center;font-size:170px}
#s06-flash{background:#fff}
</style>
<div class="bgfx"></div>
<div class="persp"><div class="card" id="s06-card"><video class="clip" src="assets/clips/geant.mp4" data-start="0.0" data-duration="3.4" muted playsinline></video><div class="shine"></div></div></div>
<div class="t" id="s06-h1">héros de l'enfer</div>
<div class="strike" id="s06-strike"></div>
<div class="t red" id="s06-none">personne pour avaler</div>
<div class="t row2" id="s06-r0">les nazis</div>
<div class="t row2" id="s06-r1">la guerre</div>
<div class="t row2" id="s06-r2">les bombes</div>
<div class="t row2" id="s06-r3">le sida · la SOA · le mont Hio</div>
<div class="persp" id="s06-qs">
  <div class="qc" id="s06-q0"><i>?</i><b>6e SENS</b></div>
  <div class="qc" id="s06-q1"><i>?</i><b>L'ÉTOILE</b></div>
  <div class="qc" id="s06-q2"><i>?</i><b>4 VOIES</b></div>
</div>
<div class="t red" id="s06-all-t">tout revient</div>
<div class="flash" id="s06-flash"></div>
<div class="vig"></div>
@@@js
// Pas de Héros de l'Enfer… — Chainsaw Man rayé, l'image se vide
cardIn("#s06-card", 0.0, 8, -25, 0.5);
flipIn("#s06-h1", W(42.75));
strike("#s06-strike", W(43.4));
tl.to("#s06-card", { filter: "grayscale(1) brightness(0.45)", duration: 0.6 }, W(43.4));
// … donc personne pour les avaler.
flipIn("#s06-none", W(44.0));
// Les nazis, la guerre, les bombes… — tout ce qui avait été effacé se reforme
tl.to(["#s06-card", "#s06-h1", "#s06-strike", "#s06-none"], { opacity: 0, y: -50, duration: 0.3, ease: "power2.in" }, W(45.35));
const rws = ["#s06-r0", "#s06-r1", "#s06-r2", "#s06-r3"];
const at = [45.7, 46.25, 46.85, 47.15];
rws.forEach((r, i) => {
  gsap.set(r, { top: 230 + i * 110 });
  tl.fromTo(r, { opacity: 0, x: -80, filter: "blur(14px)" }, { opacity: 1, x: 0, filter: "blur(0px)", duration: 0.35, ease: "power3.out" }, W(at[i]));
});
// … et nos trois mystères.
["#s06-q0", "#s06-q1", "#s06-q2"].forEach((q, i) => tl.fromTo(q, { rotationY: -100, z: -500, opacity: 0 }, { rotationY: 0, z: 0, opacity: 1, duration: 0.45, ease: "back.out(1.3)" }, W(47.6) + i * 0.15));
// Tout revient.
tl.fromTo("#s06-flash", { opacity: 0 }, { opacity: 0.8, duration: 0.05, yoyo: true, repeat: 1 }, W(48.65));
slamIn("#s06-all-t", W(48.67), 2.6);
shake("#s06-qs", W(48.7), 0.35, 14, 6);
tl.to(["#s06-r0", "#s06-r1", "#s06-r2", "#s06-r3", "#s06-qs", "#s06-all-t"], { opacity: 0, duration: 0.3 }, 7.3);

@@@ s07
@bg #050506
<style>
#s07-chip{left:395px;top:200px}
#s07-c1{left:260px;top:300px;width:560px;height:879px}
#s07-mort{left:0;right:0;top:1060px;text-align:center;font-size:220px}
#s07-c2{left:160px;top:380px;width:760px;height:760px}
#s07-pas{left:0;right:0;top:220px;text-align:center;font-size:110px}
#s07-word{left:0;right:0;top:560px;text-align:center;font-size:300px}
#s07-word span{display:inline-block}
#s07-ex{left:0;right:0;top:900px;text-align:center;font-size:110px}
.qc{position:absolute;top:620px;width:280px;height:400px;border-radius:26px;background:linear-gradient(160deg,#1d1b20,#0b0a0d);box-shadow:0 40px 80px #000000d0,0 0 0 2px #ffffff18}
.qc i{position:absolute;left:0;right:0;top:40px;text-align:center;font-family:"Anton";font-style:normal;font-size:220px;color:#3a3a40;line-height:1}
.qc b{position:absolute;left:0;right:0;bottom:30px;text-align:center;font-family:"Inter";font-weight:900;font-size:30px;letter-spacing:4px;color:#f4f1ee}
#s07-q0{left:80px}#s07-q1{left:400px}#s07-q2{left:720px}
#s07-aussi{left:0;right:0;top:280px;text-align:center;font-size:130px}
</style>
<div class="bgfx"></div>
<div class="chip" id="s07-chip">La preuve</div>
<div class="persp"><div class="card" id="s07-c1"><img src="assets/images/cases/demon-cerveau.jpg" alt="Le démon-cerveau : voir tous les devil hunters morts"><div class="shine"></div></div></div>
<div class="t red" id="s07-mort" data-layout-allow-overlap>la mort</div>
<div class="persp"><div class="card" id="s07-c2"><img src="assets/images/cases/denji-a-terre.jpg" alt="Denji à terre"><div class="shine"></div></div></div>
<div class="t" id="s07-pas">pas oubliée</div>
<div class="t red" id="s07-word"></div>
<div class="t" id="s07-ex">existe à nouveau</div>
<div class="persp" id="s07-qs">
  <div class="qc" id="s07-q0"><i>?</i><b>6e SENS</b></div>
  <div class="qc" id="s07-q1"><i>?</i><b>L'ÉTOILE</b></div>
  <div class="qc" id="s07-q2"><i>?</i><b>4 VOIES</b></div>
</div>
<div class="t red" id="s07-aussi">les autres aussi</div>
<div class="vig"></div>
@@@js
// La preuve ?
fadeIn("#s07-chip", W(50.1), 0.2);
tl.fromTo("#s07-chip", { scale: 0.6 }, { scale: 1, duration: 0.35, ease: "back.out(2)" }, W(50.1));
// Dans le dernier chapitre, on reparle de la mort.
cardIn("#s07-c1", W(51.2), 8, -28, 0.7);
tl.fromTo("#s07-c1 img", { scale: 1.1 }, { scale: 1, duration: 2.2, ease: "power1.out" }, W(51.2));
slamIn("#s07-mort", W(53.2));
shake("#s07-c1", W(53.25), 0.3, 12, 4);
// Si les gens y pensent, c'est qu'ils l'ont pas oubliée.
fadeOut("#s07-chip", W(53.85), 0.2);
cardOut("#s07-c1", W(53.85), 35, 0.35);
fadeOut("#s07-mort", W(53.85), 0.2);
cardIn("#s07-c2", W(53.95), 10, 30, 0.6);
flipIn("#s07-pas", W(55.6));
// Elle existe à nouveau. — les lettres de « MORT » se reforment (l'inverse de l'effacement)
cardOut("#s07-c2", W(56.6), -35, 0.35);
flipOut("#s07-pas", W(56.6));
const word = document.getElementById("s07-word");
[..."MORT"].forEach((ch) => { const s = document.createElement("span"); s.textContent = ch; word.appendChild(s); });
gsap.utils.toArray("#s07-word span").forEach((s, i) => tl.fromTo(s, { opacity: 0, y: -120 + i * 60, x: (i - 1.5) * 90, filter: "blur(16px)" }, { opacity: 1, y: 0, x: 0, filter: "blur(0px)", duration: 0.4, ease: "power3.out" }, W(56.8) + i * 0.08));
flipIn("#s07-ex", W(57.2));
// Et si elle est revenue… les autres aussi. — les trois « ? » s'allument
tl.to(["#s07-word", "#s07-ex"], { opacity: 0, y: -60, duration: 0.3, ease: "power2.in" }, W(58.1));
["#s07-q0", "#s07-q1", "#s07-q2"].forEach((q, i) => tl.fromTo(q, { rotationY: -100, z: -500, opacity: 0 }, { rotationY: 0, z: 0, opacity: 1, duration: 0.45, ease: "back.out(1.3)" }, W(58.25) + i * 0.12));
["#s07-q0 i", "#s07-q1 i", "#s07-q2 i"].forEach((q, i) => tl.to(q, { color: "#ff2e2e", textShadow: "0 0 50px #ff2e2e", duration: 0.15 }, W(59.25) + i * 0.15));
slamIn("#s07-aussi", W(59.3));
tl.to(["#s07-qs", "#s07-aussi"], { opacity: 0, duration: 0.25 }, 10.15);

@@@ s08
@bg #050506
<style>
#s08-chip{left:368px;top:220px}
#s08-card{left:80px;top:420px;width:920px;height:656px}
#s08-eye{left:540px;top:800px}
.wave{position:absolute;left:-90px;top:-90px;width:180px;height:180px;border-radius:50%;border:4px solid #ff2e2e;opacity:0}
#s08-iris{position:absolute;left:-150px;top:-80px;width:300px;height:160px;border-radius:50%;background:#f4f1ee;clip-path:ellipse(50% 50% at 50% 50%);box-shadow:0 0 60px #ff2e2e88}
#s08-pupil{position:absolute;left:-55px;top:-55px;width:110px;height:110px;border-radius:50%;background:radial-gradient(circle,#050506 0 30%,#ff2e2e 31% 60%,#7a0b0b 61%)}
#s08-sens{left:0;right:0;top:250px;text-align:center;font-size:130px}
#s08-starbox{left:540px;top:600px}
#s08-rays{position:absolute;left:-500px;top:-500px;width:1000px;height:1000px;border-radius:50%;background:repeating-conic-gradient(#ff2e2e22 0 6deg,transparent 6deg 18deg);-webkit-mask-image:radial-gradient(circle,#000 0,transparent 65%);mask-image:radial-gradient(circle,#000 0,transparent 65%)}
#s08-glow{position:absolute;left:-260px;top:-260px;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,#ffffffee 0,#ffd0d0aa 12%,#ff2e2e44 35%,transparent 70%)}
#s08-star{position:absolute;left:-110px;top:-110px;width:220px;height:220px;background:#fff;clip-path:polygon(50% 0,58% 42%,100% 50%,58% 58%,50% 100%,42% 58%,0 50%,42% 42%)}
#s08-ground{left:0;right:0;top:1150px;height:770px;background:linear-gradient(#0a0709,#050506)}
#s08-st{left:0;right:0;top:1000px;text-align:center;font-size:110px}
#s08-hall{left:540px;top:820px}
.door{position:absolute;top:-230px;width:170px;height:330px;border-radius:12px 12px 0 0;background:linear-gradient(#1d1b20,#0b0a0d);box-shadow:0 0 0 3px #ffffff22,0 30px 60px #000c}
.door b{position:absolute;left:0;right:0;top:110px;text-align:center;font-family:"Anton";font-weight:400;font-size:90px;color:#3a3a40}
.door.m b{font-size:44px;top:140px;color:#f4f1ee}
#s08-d0{left:-470px}#s08-d1{left:-275px}#s08-d2{left:-85px}#s08-d3{left:105px}#s08-d4{left:300px}
#s08-portes{left:0;right:0;top:260px;text-align:center;font-size:110px}
</style>
<div class="bgfx"></div>
<div class="chip" id="s08-chip">Nouveau monde</div>
<div class="persp"><div class="card" id="s08-card"><img src="assets/images/cases/denji-nouveau-monde.jpg" alt="Denji devil hunter dans le nouveau monde"><div class="shine"></div></div></div>
<div class="abs" id="s08-eye">
  <div class="wave" id="s08-w0"></div><div class="wave" id="s08-w1"></div><div class="wave" id="s08-w2"></div><div class="wave" id="s08-w3"></div>
  <div id="s08-iris"></div><div id="s08-pupil"></div>
</div>
<div class="t" id="s08-sens">un sens en plus</div>
<div class="abs" id="s08-ground"></div>
<div class="abs" id="s08-starbox"><div id="s08-rays"></div><div id="s08-glow"></div><div id="s08-star"></div></div>
<div class="t red" id="s08-st">elle brille à nouveau</div>
<div class="persp"><div class="p3" id="s08-hall">
  <div class="door m" id="s08-d0"><b>MORT</b></div>
  <div class="door" id="s08-d1"><b>?</b></div>
  <div class="door" id="s08-d2"><b>?</b></div>
  <div class="door" id="s08-d3"><b>?</b></div>
  <div class="door" id="s08-d4"><b>?</b></div>
</div></div>
<div class="t" id="s08-portes">+4 sorties</div>
<div class="vig"></div>
@@@js
// Concrètement, ça donne quoi ?
fadeIn("#s08-chip", W(60.55), 0.2);
cardIn("#s08-card", W(60.45), 10, -30, 0.7);
drift("#s08-card", W(61.15), 1.2);
// … y a des humains qui ont un sens en plus. — un œil, des ondes qui partent comme un radar
cardOut("#s08-card", W(62.45), 35, 0.4);
fadeOut("#s08-chip", W(62.45), 0.2);
tl.fromTo("#s08-eye", { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.45, ease: "back.out(1.6)" }, W(62.75));
["#s08-w0", "#s08-w1", "#s08-w2", "#s08-w3"].forEach((w, i) => {
  for (let k = 0; k < 3; k++) tl.fromTo(w, { scale: 1, opacity: 0.9 }, { scale: 4.5, opacity: 0, duration: 1.0, ease: "power1.out", immediateRender: false }, W(62.9) + k * 1.0 + i * 0.25);
});
tl.fromTo("#s08-pupil", { x: -40 }, { x: 40, duration: 1.4, ease: "sine.inOut", yoyo: true, repeat: 1 }, W(63.0));
slamIn("#s08-sens", W(65.2));
// Une étoile qui brille à nouveau au-dessus des gosses.
tl.to(["#s08-eye", "#s08-sens"], { opacity: 0, scale: 0.6, duration: 0.3, ease: "power2.in" }, W(65.85));
fadeIn("#s08-ground", W(66.0), 0.3);
tl.fromTo("#s08-starbox", { y: 520, opacity: 0, scale: 0.4 }, { y: 0, opacity: 1, scale: 1, duration: 0.9, ease: "power3.out" }, W(66.1));
tl.fromTo("#s08-rays", { rotation: 0 }, { rotation: 40, duration: 2.8, ease: "none" }, W(66.1));
tl.fromTo("#s08-glow", { scale: 0.9 }, { scale: 1.15, duration: 0.6, ease: "sine.inOut", yoyo: true, repeat: 3 }, W(66.6));
flipIn("#s08-st", W(66.75));
// Et des gens qui meurent… avec quatre autres portes de sortie. — un couloir de portes en 3D
tl.to(["#s08-starbox", "#s08-st", "#s08-ground"], { opacity: 0, duration: 0.3 }, W(68.75));
gsap.set("#s08-hall", { rotationX: -8 });
tl.fromTo("#s08-hall", { z: -1400, rotationY: 25, opacity: 0 }, { z: 0, rotationY: -6, opacity: 1, duration: 0.7, ease: "power3.out" }, W(68.85));
tl.to("#s08-hall", { rotationY: 6, duration: 2.6, ease: "sine.inOut" }, W(69.55));
tl.fromTo("#s08-d0", { y: 0 }, { y: -20, duration: 0.25, yoyo: true, repeat: 1 }, W(69.7));
["#s08-d1 b", "#s08-d2 b", "#s08-d3 b", "#s08-d4 b"].forEach((d, i) => tl.to(d, { color: "#ff2e2e", textShadow: "0 0 40px #ff2e2e", duration: 0.12 }, W(70.39) + i * 0.17));
flipIn("#s08-portes", W(70.4));
tl.to(["#s08-hall", "#s08-portes"], { opacity: 0, duration: 0.3 }, 11.7);

@@@ s09
@bg #050506
<style>
#s09-c1{left:80px;top:430px;width:920px;height:600px}
#s09-c1 img{object-position:50% 32%}
#s09-t{left:0;right:0;top:240px;text-align:center;font-size:120px}
#s09-strike{left:200px;top:300px;width:680px}
#s09-cam{position:absolute;inset:0}
#s09-card{left:60px;top:520px;width:960px;height:766px}
</style>
<div class="bgfx"></div>
<div class="persp"><div class="card" id="s09-c1"><img src="assets/images/cases/chainsaw-pile.jpg" alt="Chainsaw Man sur les démons dévorés"><div class="shine"></div></div></div>
<div class="t" id="s09-t">chainsaw man</div>
<div class="strike" id="s09-strike"></div>
<div class="cam" id="s09-cam">
  <div class="persp"><div class="card" id="s09-card"><img src="assets/images/cases/trois-bulles.jpg" alt="Les trois bulles"><div class="shine"></div></div></div>
</div>
<div class="vig"></div>
@@@js
// Et Chainsaw Man est plus là pour les bouffer.
cardIn("#s09-c1", 0.0, 8, -25, 0.5);
flipIn("#s09-t", W(72.7));
strike("#s09-strike", W(73.5));
tl.to("#s09-c1", { filter: "grayscale(1) brightness(0.35)", duration: 0.8 }, W(73.5));
tl.to(["#s09-c1", "#s09-t", "#s09-strike"], { opacity: 0, z: -900, duration: 0.4, ease: "power2.in" }, W(74.5));
// Tu sais ce que ça veut dire ? — retour sur la case des trois bulles : même cadrage et même poussée de caméra
// que l'ouverture (0,015 / s), pour qu'elle arrive pile à 1,0 sur la dernière image
const D = 3.902;
gsap.set("#s09-cam", { opacity: 0, transformOrigin: "540px 903px" });
tl.set("#s09-cam", { opacity: 1 }, W(74.95));
tl.fromTo("#s09-cam", { scale: 1 - 0.015 * (D - W(74.95)) }, { scale: 1, duration: D - W(74.95), ease: "none", immediateRender: false }, W(74.95));
