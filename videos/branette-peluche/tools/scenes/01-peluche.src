@@@ s01
@bg #000
<style>
#s01-cam{position:absolute;inset:0}
#s01-rain{left:240px;top:240px;width:600px;height:1640px;right:auto;bottom:auto}
#s01-stage{position:absolute;inset:0;perspective:1600px;perspective-origin:840px 1060px}
#s01-door{position:absolute;left:240px;top:240px;width:600px;height:1640px;background:url(assets/decor/porte-battant.png) 0 0/600px 1640px;image-rendering:pixelated;transform-origin:100% 50%}
#s01-bra{left:430px;top:1606px;filter:brightness(.55) contrast(1.15)}
</style>
<div class="cam" id="s01-cam">
  <img class="bg" src="assets/decor/porte-fond.png" alt="ta porte d'entrée ouverte sur la rue, la nuit">
  <div class="rain" id="s01-rain"></div>
  <div class="spr" id="s01-bra"></div>
  <div id="s01-stage"><div id="s01-door"></div></div>
</div>
<div class="vignette"></div>
@@@js
// raccord de boucle : même plan que la toute fin (porte qui finit de s'ouvrir, peluche sur le paillasson)
sheet(document.getElementById("s01-bra"), "branette-sheet", 4, 0, 2.3);
tl.fromTo("#s01-door", { rotationY: 100 }, { rotationY: 104, duration: 2.3, ease: "none" }, 0);
tl.fromTo("#s01-rain", { backgroundPosition: "0px 0px" }, { backgroundPosition: "0px 1677px", duration: 2.3, ease: "none" }, 0);
tl.fromTo("#s01-cam", { scale: 1 }, { scale: 1.06, duration: 2.3, ease: "none", transformOrigin: "540px 1700px" }, 0);

@@@ s02
@bg #000
<style>
#s02-back{filter:blur(3px) brightness(.7)}
#s02-cam{position:absolute;inset:0}
#s02-bra{left:155px;top:520px;filter:brightness(.6) contrast(1.15) saturate(.8)}
#s02-eyes{left:255px;top:740px;width:300px;height:140px;background:radial-gradient(ellipse,#ff1a2a55,transparent 70%);opacity:.6}
</style>
<img class="bg" id="s02-back" src="assets/decor/porte-fond.png" alt="">
<div class="cam" id="s02-cam">
  <div class="spr" id="s02-bra"></div>
  <div class="abs" id="s02-eyes"></div>
  <div id="s02-drops"></div>
</div>
<div class="rain" id="s02-rain" style="opacity:.8"></div>
<div class="vignette"></div>
@@@js
// gros plan : une petite poupée noire, trempée
gsap.set("#s02-back", { scale: 3.2, transformOrigin: "540px 1800px" });
sheet(document.getElementById("s02-bra"), "branette-sheet", 14, 0, 5.8);
tl.fromTo("#s02-cam", { scale: 1.15 }, { scale: 1, duration: 1.2, ease: "power2.out", transformOrigin: "540px 900px" }, 0);
tl.fromTo("#s02-rain", { backgroundPosition: "0px 0px" }, { backgroundPosition: "-200px 4200px", duration: 5.8, ease: "none" }, 0);
flicker("#s02-eyes", 0, 5.8, 0.35, 3);
// trempée : l'eau goutte de la peluche
const drops = motes(document.getElementById("s02-drops"), 14, 7, [260, 1180, 520, 40], "drop");
drops.forEach((d, i) => {
  const t0 = W(3.9) + hash(i * 3) * 0.6;
  tl.fromTo(d, { y: 0, opacity: 0.9 }, { y: 760, opacity: 0.3, duration: 0.7, ease: "power2.in", repeat: 2, repeatDelay: hash(i) * 0.4 }, t0);
});
// … avec une fermeture éclair à la place de la bouche
tl.to("#s02-cam", { scale: 2.3, duration: 0.6, ease: "power2.inOut", transformOrigin: "435px 912px" }, W(5.5));

@@@ s03
@bg #000
<style>
.s03-shot{position:absolute;inset:0;opacity:0}
#s03-pola{left:200px;top:300px;width:680px;height:800px;background:#e8dcc4;padding:40px 40px 160px;box-shadow:0 20px 60px #000}
#s03-pola .in{position:relative;width:600px;height:600px;background:radial-gradient(#6e4f34,#2a1c10 80%);overflow:hidden}
#s03-pbra{left:52px;top:70px}
#s03-pola .cap{position:absolute;left:40px;bottom:46px;font-family:"Pixel";font-size:44px;color:#3a2a1a}
#s03-cbra{left:760px;top:938px}
#s03-clip{position:absolute;left:0;top:0;width:1080px;height:960px;overflow:hidden}
#s03-fbra{left:402px;top:0}
#s03-ball{left:390px;top:700px;width:300px;height:300px;image-rendering:pixelated}
#s03-glow{left:240px;top:550px;width:600px;height:600px;border-radius:50%;background:radial-gradient(#fff3d0aa,transparent 65%);opacity:0}
</style>
<div class="s03-shot sepia" id="s03-a"><div class="abs" id="s03-pola"><div class="in"><div class="spr" id="s03-pbra"></div></div><div class="cap">moi + doudou</div></div></div>
<div class="s03-shot sepia" id="s03-b"><img class="bg" src="assets/decor/souvenir-chambre.png" alt="ta chambre d'enfant"><div class="spr" id="s03-cbra"></div></div>
<div class="s03-shot sepia" id="s03-c"><img class="bg" src="assets/decor/poubelle.png" alt="la poubelle"><div id="s03-clip"><div class="spr" id="s03-fbra"></div></div></div>
<div class="s03-shot sepia" id="s03-d"><img class="bg" src="assets/decor/poubelle.png" alt="" style="filter:brightness(.4)"><div class="abs" id="s03-glow"></div><img class="px" id="s03-ball" src="assets/sprites/poke-ball.png" alt="une Poké Ball"></div>
<div class="film" id="s03-film"></div>
<div class="flash" id="s03-flash" style="background:#f0e2c0"></div>
<div class="vignette"></div>
@@@js
// souvenir (sépia, pellicule) : c'est la TIENNE
const shots = [["#s03-a", 0], ["#s03-b", W(10.6)], ["#s03-c", W(13.57)], ["#s03-d", W(15.87)]];
shots.forEach(([sel, t], i) => {
  tl.set(sel, { opacity: 1 }, t);
  if (i + 1 < shots.length) tl.set(sel, { opacity: 0 }, shots[i + 1][1]);
  tl.fromTo("#s03-flash", { opacity: 0.55 }, { opacity: 0, duration: 0.35, immediateRender: false }, t);
});
flicker("#s03-film", 0, 9.75, 0.5, 4);
sheet(document.getElementById("s03-pbra"), "branette-sheet", 9, 0, 2.6);
tl.fromTo("#s03-pola", { scale: 1.25, rotation: -10 }, { scale: 1, rotation: -4, duration: 0.6, ease: "power3.out" }, 0);
tl.to("#s03-pola", { scale: 1.12, duration: 0.25, ease: "power2.out" }, W(9.99));
// celle que tu serrais tous les soirs
sheet(document.getElementById("s03-cbra"), "branette-sheet", 5, W(10.6), 3.0);
tl.fromTo("#s03-b", { scale: 1.1 }, { scale: 1, duration: 3.0, ease: "sine.out", transformOrigin: "880px 1100px" }, W(10.6));
// jetée à la poubelle : elle tombe et disparaît dans la poubelle
sheet(document.getElementById("s03-fbra"), "branette-sheet", 5, W(13.57), 2.3);
tl.fromTo("#s03-fbra", { y: 100, rotation: 0 }, { y: 1000, rotation: 160, duration: 1.0, ease: "power2.in" }, W(14.2));
// … le jour où t'as eu ton premier Pokémon
tl.fromTo("#s03-ball", { y: 300, scale: 0.6 }, { y: 0, scale: 1, duration: 0.6, ease: "back.out(1.6)" }, W(15.95));
tl.fromTo("#s03-glow", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1.2, duration: 0.8, ease: "power2.out" }, W(16.7));

@@@ s04
@bg #000
<style>
#s04-cam{position:absolute;inset:0}
#s04-win{left:800px;top:560px;width:40px;height:56px;background:#f0c060;box-shadow:0 0 40px #f0a040;opacity:0}
#s04-bra{left:-200px;top:1400px;filter:brightness(.5)}
#s04-lid{left:424px;top:1150px;width:432px;height:52px;background:#151a20;border-top:6px solid #2a3340;transform-origin:0 50%}
</style>
<div class="cam" id="s04-cam">
  <img class="bg" src="assets/decor/rue.png" alt="la rue sous la pluie, une benne sous un lampadaire">
  <div class="abs" id="s04-win"></div>
  <div class="spr" id="s04-bra"></div>
  <div class="abs" id="s04-lid"></div>
</div>
<div class="rain" id="s04-rain"></div>
<div class="vignette"></div>
@@@js
// Qui l'a ramenée ? Personne. — la rue est vide
tl.fromTo("#s04-cam", { scale: 1 }, { scale: 1.1, duration: W(21.4), ease: "sine.inOut", transformOrigin: "640px 1100px" }, 0);
tl.fromTo("#s04-rain", { backgroundPosition: "0px 0px" }, { backgroundPosition: "-300px 4600px", duration: 6.6, ease: "none" }, 0);
// Un voisin. : une fenêtre s'allume… et s'éteint
tl.fromTo("#s04-win", { opacity: 0 }, { opacity: 1, duration: 0.08 }, W(19.6));
tl.to("#s04-win", { opacity: 0, duration: 0.08 }, W(20.4));
// Alors tu la jettes. Dans la benne. — le couvercle claque
sheet(document.getElementById("s04-bra"), "branette-sheet", 4, 0, 6.6);
const arc = { p: 0 };
tl.fromTo(arc, { p: 0 }, { p: 1, duration: 0.75, ease: "none", immediateRender: false, onUpdate: () => {
  const q = arc.p; gsap.set("#s04-bra", { x: 300 + 650 * q, y: -560 * q - 520 * Math.sin(Math.PI * q) * 0.6, rotation: 400 * q, opacity: q > 0.97 ? 0 : 1 });
} }, W(21.5));
gsap.set("#s04-bra", { opacity: 0 });
tl.set("#s04-bra", { opacity: 1 }, W(21.5));
gsap.set("#s04-lid", { rotation: -70 });
tl.to("#s04-lid", { rotation: 0, duration: 0.14, ease: "power4.in" }, W(22.35));
shake("#s04-cam", W(22.5), 0.3, 14, 4);
tl.to("#s04-cam", { scale: 0.96, duration: 1.3, ease: "power2.out" }, W(23.4));

@@@ s05
@bg #000
<style>
#s05-cam{position:absolute;inset:0}
#s05-bra{left:368px;top:864px;opacity:0;filter:brightness(.62) contrast(1.15)}
#s05-eyes{left:440px;top:1000px;width:170px;height:90px;background:radial-gradient(ellipse,#ff1a2a66,transparent 70%);opacity:0}
</style>
<div class="cam" id="s05-cam">
  <img class="bg" id="s05-room" src="assets/decor/chambre-fond.png" alt="ta chambre au petit matin">
  <div class="spr" id="s05-bra"></div>
  <div class="abs" id="s05-eyes"></div>
</div>
<div class="black" id="s05-black" style="opacity:1"></div>
<div class="vignette"></div>
@@@js
// Le lendemain matin… : la chambre sort lentement du noir
tl.to("#s05-black", { opacity: 0, duration: 1.4, ease: "power1.inOut" }, W(24.7));
// … elle est sur ton lit. (coupe sèche)
sheet(document.getElementById("s05-bra"), "branette-sheet", 8, 0, 5.35);
tl.set(["#s05-bra", "#s05-eyes"], { opacity: 1 }, W(26.33));
shake("#s05-cam", W(26.35), 0.25, 10, 5);
flicker("#s05-eyes", W(26.4), 5.35 - W(26.4), 0.4, 6);
// Assise. Tournée vers toi. : on s'approche de son visage
tl.fromTo("#s05-cam", { scale: 1 }, { scale: 1.25, duration: 0.8, ease: "power2.out", transformOrigin: "520px 1040px" }, W(27.55));
tl.to("#s05-cam", { scale: 2.1, duration: 0.9, ease: "power2.inOut" }, W(28.62));

@@@ s06
@bg #07040c
<style>
#s06-zip{left:0;top:680px;width:1080px;height:560px;background:url(assets/decor/fermeture.png) 0 0/10800px 560px;image-rendering:pixelated}
#s06-eyes{left:190px;top:300px;width:700px;height:200px;background:radial-gradient(ellipse at 30% 50%,#ff1a2a88,transparent 30%),radial-gradient(ellipse at 70% 50%,#ff1a2a88,transparent 30%);opacity:.7}
</style>
<div class="cam" id="s06-cam"><div class="abs" id="s06-eyes"></div><div class="abs" id="s06-zip"></div></div>
<div class="vignette"></div>
@@@js
// Et la fermeture éclair est un tout petit peu plus ouverte. — un cran
const zip = (el) => (k, t) => tl.set(el, { backgroundPosition: `${-k * 1080}px 0px` }, t);
const z = zip(document.getElementById("s06-zip"));
z(0, 0);
tl.fromTo("#s06-cam", { scale: 1 }, { scale: 1.12, duration: 2.75, ease: "sine.inOut", transformOrigin: "760px 960px" }, 0);
flicker("#s06-eyes", 0, 2.75, 0.4, 7);
z(1, W(32.4));
shake("#s06-zip", W(32.4), 0.2, 8, 2);

@@@ s07
@bg #000
<style>
.s07-shot{position:absolute;inset:0;opacity:0}
#s07-fbra{left:375px;top:1220px;filter:brightness(.25) sepia(1) saturate(3) hue-rotate(-20deg)}
#s07-glow{left:140px;top:900px;width:800px;height:800px;border-radius:50%;background:radial-gradient(#ff8a2a88,transparent 65%)}
#s07-sea{position:absolute;left:0;top:0;width:1080px;height:940px;overflow:hidden}
#s07-mbra{left:430px;top:760px;filter:brightness(.35) saturate(.5)}
</style>
<div class="s07-shot" id="s07-a"><img class="bg" src="assets/decor/feu.png" alt="un feu"><div class="abs" id="s07-glow"></div><div class="spr" id="s07-fbra"></div><div id="s07-embers"></div></div>
<div class="s07-shot" id="s07-b"><img class="bg" src="assets/decor/tombe.png" alt="un trou rebouché"><div id="s07-dirt"></div></div>
<div class="s07-shot" id="s07-c"><img class="bg" src="assets/decor/mer.png" alt="la mer la nuit"><div id="s07-sea"><div class="spr" id="s07-mbra"></div></div></div>
<div class="flash" id="s07-flash"></div>
<div class="vignette"></div>
@@@js
// Tu la brûles. Tu l'enterres. Tu la jettes dans la mer.
const shots = [["#s07-a", 0], ["#s07-b", W(33.42)], ["#s07-c", W(34.1)]];
shots.forEach(([sel, t], i) => {
  tl.set(sel, { opacity: 1 }, t);
  if (i + 1 < shots.length) tl.set(sel, { opacity: 0 }, shots[i + 1][1]);
  tl.fromTo("#s07-flash", { opacity: 0.35 }, { opacity: 0, duration: 0.2, immediateRender: false }, t);
});
sheet(document.getElementById("s07-fbra"), "branette-sheet", 6, 0, 0.9);
flicker("#s07-glow", 0, 0.9, 0.5, 8);
motes(document.getElementById("s07-embers"), 24, 9, [300, 1200, 480, 300], "ember").forEach((e, i) =>
  tl.fromTo(e, { y: 0, opacity: 1 }, { y: -500 - hash(i) * 400, opacity: 0, duration: 0.8, ease: "power1.out" }, hash(i * 5) * 0.3));
motes(document.getElementById("s07-dirt"), 30, 11, [380, 1300, 320, 60], "ember").forEach((e, i) => {
  gsap.set(e, { background: "#2c231a", boxShadow: "none" });
  tl.fromTo(e, { y: -400, opacity: 1 }, { y: 0, opacity: 1, duration: 0.3, ease: "power2.in" }, W(33.42) + hash(i) * 0.3);
});
sheet(document.getElementById("s07-mbra"), "branette-sheet", 4, W(34.1), 1.75);
tl.fromTo("#s07-mbra", { y: 0, rotation: 0 }, { y: 260, rotation: -20, duration: 1.4, ease: "power1.in" }, W(34.3));

@@@ s08
@bg #000
<style>
.s08-shot{position:absolute;inset:0;opacity:0}
#s08-zip{left:0;top:680px;width:1080px;height:560px;background:url(assets/decor/fermeture.png) 0 0/10800px 560px;image-rendering:pixelated}
</style>
<div class="s08-shot" id="s08-a"><img class="bg" src="assets/decor/porte-fond.png" alt=""><div class="spr" id="s08-b1" style="left:430px;top:1606px;filter:brightness(.55)"></div></div>
<div class="s08-shot" id="s08-b"><img class="bg" src="assets/decor/chambre-fond.png" alt=""><div class="spr" id="s08-b2" style="left:368px;top:864px;filter:brightness(.6)"></div></div>
<div class="s08-shot" id="s08-c"><div class="spr" id="s08-b3" style="left:160px;top:460px;filter:brightness(.6) contrast(1.2)"></div></div>
<div class="s08-shot" id="s08-d" style="background:#07040c"><div class="abs" id="s08-zip"></div></div>
<div class="flash" id="s08-flash"></div>
<div class="vignette"></div>
@@@js
// Chaque fois, elle revient. (trois retours, de plus en plus près) Chaque fois, un cran de plus.
const shots = [["#s08-a", 0], ["#s08-b", W(36.55)], ["#s08-c", W(37.1)], ["#s08-d", W(37.77)]];
shots.forEach(([sel, t], i) => {
  tl.set(sel, { opacity: 1 }, t);
  if (i + 1 < shots.length) tl.set(sel, { opacity: 0 }, shots[i + 1][1]);
  tl.fromTo("#s08-flash", { opacity: 0.5 }, { opacity: 0, duration: 0.15, immediateRender: false }, t);
});
sheet(document.getElementById("s08-b1"), "branette-sheet", 4, 0, 0.7);
sheet(document.getElementById("s08-b2"), "branette-sheet", 8, W(36.55), 0.6);
sheet(document.getElementById("s08-b3"), "branette-sheet", 20, W(37.1), 0.7);
const zipEl = document.getElementById("s08-zip");
[[1, W(37.77)], [2, W(38.58)], [3, W(38.9)], [4, W(39.4)]].forEach(([k, t]) => {
  tl.set(zipEl, { backgroundPosition: `${-k * 1080}px 0px` }, t);
  if (k > 1) shake(zipEl, t, 0.15, 8, k);
});
