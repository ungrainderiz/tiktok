@@@ s09
@bg #0B1F17
<style>
#s09-red{position:absolute;inset:0;background:radial-gradient(circle at 25% 25%,#a3260b,#5c1206 60%);clip-path:polygon(0 0,100% 0,100% 40%,0 64%)}
#s09-blue{position:absolute;inset:0;background:radial-gradient(circle at 75% 75%,#1350b0,#06275c 60%);clip-path:polygon(0 64%,100% 40%,100% 100%,0 100%)}
#s09-g1{left:-60px;top:250px;font-size:300px;opacity:.1}
#s09-g2{left:-40px;top:1380px;font-size:300px;opacity:.1}
#s09-groudon{left:-10px;top:330px;width:600px;filter:drop-shadow(0 0 30px #ff5a1f)}
#s09-kyogre{left:470px;top:860px;width:600px;filter:drop-shadow(0 0 30px #3fa9ff)}
#s09-earth{left:430px;top:770px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle at 38% 30%,#6cc47a,#2a6f8f 58%,#0b2340);box-shadow:0 0 0 10px #ffffff33}
#s09-dry,#s09-wet{position:absolute;inset:0;border-radius:50%;opacity:0}
#s09-dry{background:radial-gradient(circle at 38% 30%,#ffcf6b,#c2410c 70%)}
#s09-wet{background:radial-gradient(circle at 38% 30%,#7fd0ff,#0b3a8a 70%)}
#s09-t1{left:560px;top:480px;width:480px;font-size:64px;color:#ffc9a8;text-shadow:0 6px 0 #000}
#s09-t2{left:60px;top:1040px;width:420px;font-size:64px;color:#bfe3ff;text-shadow:0 6px 0 #000}
</style>
<div class="cam" id="s09-cam">
  <div id="s09-red"></div><div id="s09-blue"></div>
  <div class="ghost" id="s09-g1">LAVE</div><div class="ghost" id="s09-g2">DÉLUGE</div>
  <img class="px" id="s09-groudon" src="assets/sprites/primo-groudon.png" alt="Primo-Groudon">
  <img class="px" id="s09-kyogre" src="assets/sprites/primo-kyogre.png" alt="Primo-Kyogre">
  <div class="abs" id="s09-earth"><div id="s09-dry"></div><div id="s09-wet"></div></div>
  <div class="disp" id="s09-t1">Assécher les océans</div>
  <div class="disp" id="s09-t2">Noyer la planète</div>
</div>
@@@js
tl.fromTo("#s09-red", { x: -1100 }, { x: 0, duration: 0.35, ease: "expo.out" }, 0);
tl.fromTo("#s09-blue", { x: 1100 }, { x: 0, duration: 0.35, ease: "expo.out" }, 0);
tl.fromTo("#s09-g1", { x: 0 }, { x: -300, duration: 4.2, ease: "none" }, 0);
tl.fromTo("#s09-g2", { x: -300 }, { x: 0, duration: 4.2, ease: "none" }, 0);
tl.fromTo("#s09-earth", { scale: 0, rotation: 0 }, { scale: 1, rotation: 20, duration: 0.5, ease: "back.out(2)" }, 0.2);
tl.fromTo("#s09-groudon", { x: -700 }, { x: 0, duration: 0.4, ease: "expo.out" }, W(41.92));
shake("#s09-cam", W(42.2), 0.3, 18, 2);
tl.fromTo("#s09-kyogre", { x: 700 }, { x: 0, duration: 0.4, ease: "expo.out" }, W(42.72));
shake("#s09-cam", W(43.0), 0.3, 18, 4);
tl.fromTo("#s09-groudon", { y: 0 }, { y: -18, duration: 0.5, yoyo: true, repeat: 5, ease: "sine.inOut", immediateRender: false }, W(42.4));
tl.fromTo("#s09-kyogre", { y: 0 }, { y: 18, duration: 0.5, yoyo: true, repeat: 4, ease: "sine.inOut", immediateRender: false }, W(43.2));
tl.fromTo("#s09-t1", { scale: 1.5, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "power4.out" }, W(43.76));
tl.to("#s09-dry", { opacity: 0.85, duration: 0.4 }, W(43.76));
tl.fromTo("#s09-t2", { scale: 1.5, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "power4.out" }, W(44.88));
tl.to("#s09-dry", { opacity: 0, duration: 0.3 }, W(44.88));
tl.to("#s09-wet", { opacity: 0.9, duration: 0.4 }, W(44.88));
tl.to("#s09-earth", { rotation: -20, duration: 0.12, yoyo: true, repeat: 7, ease: "sine.inOut" }, W(43.8));

@@@ s10
@bg radial-gradient(circle at 50% 45%,#2a1010,#100808 72%)
<style>
#s10-flash{position:absolute;inset:0;background:radial-gradient(circle,#E23B3B,#5a0d0d 70%);opacity:0}
#s10-q{left:60px;top:420px;width:960px;font-size:64px;color:#d9cfc0}
#s10-q span{display:inline-block}
#s10-non{left:40px;top:560px;font-size:320px;color:#E23B3B}
#s10-list{left:80px;top:940px;font-family:"Archivo Black";font-size:72px;line-height:1.45;text-transform:uppercase;color:#F3F1E4}
.s10-li{position:relative;display:flex;align-items:center;gap:26px}
.s10-box{position:relative;width:64px;height:64px;border:8px solid #F3F1E4;border-radius:8px}
.s10-chk{position:absolute;left:-4px;top:-46px;font-size:96px;color:#7ee08a;opacity:0}
</style>
<div id="s10-flash"></div>
<div class="cam" id="s10-cam">
  <div class="disp" id="s10-q"><span>Il</span> <span>intervient</span> <span>de</span> <span>lui-même</span> <span>?</span></div>
  <div class="disp" id="s10-non">NON.</div>
  <div class="abs" id="s10-list">
    <div class="s10-li"><div class="s10-box"><span class="s10-chk">✓</span></div>Prier</div>
    <div class="s10-li"><div class="s10-box"><span class="s10-chk">✓</span></div>Supplier</div>
    <div class="s10-li"><div class="s10-box"><span class="s10-chk">✓</span></div>Tout le rituel</div>
  </div>
</div>
@@@js
tl.fromTo("#s10-q span", { y: 80, opacity: 0 }, { y: 0, opacity: 1, duration: 0.3, ease: "back.out(2)", stagger: 0.1 }, W(46.4));
slam("#s10-non", W(48.1), 3);
shake("#s10-cam", W(48.34), 0.45, 30, 3);
tl.fromTo("#s10-flash", { opacity: 0 }, { opacity: 0.9, duration: 0.05 }, W(48.34));
tl.to("#s10-flash", { opacity: 0, duration: 0.6, ease: "power2.out" }, W(48.4));
const rows = gsap.utils.toArray(".s10-li");
const chks = gsap.utils.toArray(".s10-chk");
[49.64, 50.28, 50.84].forEach((t, i) => {
  tl.fromTo(rows[i], { x: -700, opacity: 0 }, { x: 0, opacity: 1, duration: 0.3, ease: "expo.out" }, W(t) - 0.1);
  pop(chks[i], W(t) + 0.15, 0.3);
});
// « rituel… » : la liste tremble d'impatience
tl.fromTo("#s10-list", { rotation: 0 }, { rotation: -1.5, duration: 0.1, yoyo: true, repeat: 5, ease: "sine.inOut" }, W(51.5));

@@@ s11
@bg radial-gradient(circle at 50% 30%,#1d4a35,#0b1f17 70%)
<style>
#s11-head{left:60px;top:420px;font-size:30px;color:#9fc7b2;width:960px}
.s11-st{position:absolute;border-top:10px solid #b8a67c}
#s11-st1{left:340px;top:770px;width:400px;height:110px;background:#8a7a5a}
#s11-st2{left:250px;top:880px;width:580px;height:110px;background:#776849}
#s11-st3{left:160px;top:990px;width:760px;height:110px;background:#62553a}
#s11-autel{left:378px;top:808px;font-size:30px;color:#F7F3D9}
#s11-ray{left:390px;top:440px;width:300px}
.s11-fan{position:absolute;top:1120px;width:120px;image-rendering:pixelated}
#s11-ola1{left:720px;top:520px;font-size:70px;color:#F4C430}
#s11-ola2{left:720px;top:590px;font-size:70px;color:#F4C430}
#s11-beam{left:490px;top:0;width:100px;height:780px;background:linear-gradient(#fff0,#fffbe0cc);opacity:0;transform-origin:50% 100%}
</style>
<div class="pix" id="s11-head">CONDITIONS POUR QU'IL BOUGE :</div>
<div class="abs" id="s11-beam"></div>
<div class="s11-st" id="s11-st3"></div><div class="s11-st" id="s11-st2"></div><div class="s11-st" id="s11-st1"></div>
<div class="pix" id="s11-autel">AUTEL ✓</div>
<img class="px" id="s11-ray" src="assets/sprites/rayquaza.png" alt="Rayquaza">
<div class="disp" id="s11-ola1">+ une</div><div class="disp" id="s11-ola2">ola !</div>
<img class="s11-fan" src="assets/sprites/foule/zigzaton.png" style="left:30px" alt="">
<img class="s11-fan" src="assets/sprites/foule/marill.png" style="left:155px" alt="">
<img class="s11-fan" src="assets/sprites/foule/arcko.png" style="left:280px" alt="">
<img class="s11-fan" src="assets/sprites/foule/poussifeu.png" style="left:405px" alt="">
<img class="s11-fan" src="assets/sprites/foule/gobou.png" style="left:530px" alt="">
<img class="s11-fan" src="assets/sprites/foule/tarsal.png" style="left:655px" alt="">
<img class="s11-fan" src="assets/sprites/foule/chenipotte.png" style="left:780px" alt="">
<img class="s11-fan" src="assets/sprites/foule/medhyena.png" style="left:905px" alt="">
@@@js
tl.fromTo("#s11-head", { clipPath: "inset(0 100% 0 0)" }, { clipPath: "inset(0 0% 0 0)", duration: 0.6, ease: "steps(29)" }, W(52.48));
const fans = gsap.utils.toArray(".s11-fan");
// la foule « prie » en attendant
fans.forEach((f, i) => {
  tl.fromTo(f, { y: 0 }, { y: -14, duration: 0.3, yoyo: true, repeat: 9, ease: "sine.inOut" }, 0.1 + i * 0.04);
});
// on construit l'autel
["#s11-st3", "#s11-st2", "#s11-st1"].forEach((s, i) => {
  tl.fromTo(s, { y: 500, opacity: 0 }, { y: 0, opacity: 1, duration: 0.3, ease: "back.out(1.6)" }, W(54.88) + i * 0.13);
});
pop("#s11-autel", W(55.6), 0.3);
// la ola
fans.forEach((f, i) => {
  tl.fromTo(f, { y: 0 }, { y: -150, duration: 0.18, yoyo: true, repeat: 1, ease: "power2.out", immediateRender: false }, W(56.2) + i * 0.07);
});
// il daigne descendre
tl.fromTo("#s11-beam", { scaleY: 0, opacity: 0 }, { scaleY: 1, opacity: 1, duration: 0.25, ease: "power2.out" }, W(56.3));
tl.fromTo("#s11-ray", { y: -900 }, { y: 0, duration: 0.5, ease: "back.out(1.4)" }, W(56.4));
tl.to("#s11-beam", { opacity: 0, duration: 0.6 }, W(57.0));
pop("#s11-ola1", W(56.44), 0.3);
pop("#s11-ola2", W(56.6), 0.3);
