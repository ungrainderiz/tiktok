@@@ s12
@bg radial-gradient(circle at 30% 20%,#1b1f3d,#05060f 72%)
<style>
.s12-stars{position:absolute;left:0;top:-200px;width:1080px;height:2320px}
#s12-st1{background-image:radial-gradient(#fff 2px,transparent 3px);background-size:97px 113px;opacity:.5}
#s12-st2{background-image:radial-gradient(#cfe3ff 3px,transparent 4px);background-size:173px 211px;background-position:40px 60px;opacity:.6}
#s12-world{position:absolute;inset:0}
#s12-earth{left:-300px;top:1440px;width:1680px;height:1680px;border-radius:50%;background:radial-gradient(circle at 50% 8%,#4fa0e8,#163f6e 38%,#0b1f3a);box-shadow:0 -20px 80px #7fd0ff66}
#s12-orbit{left:60px;top:650px;width:960px;height:360px;border:6px solid #7fd0ff55;border-radius:50%;transform:rotate(-12deg)}
#s12-sat{left:0;top:0;width:280px}
#s12-sat img{width:280px;image-rendering:pixelated;display:block}
#s12-badge{position:absolute;left:30px;top:250px;font-family:"Press Start 2P";font-size:24px;background:#F4C430;color:#10140F;padding:10px 14px}
#s12-l1{left:60px;top:420px;font-size:34px;color:#cfd7ff}
#s12-l2{left:60px;top:490px;font-size:76px;color:#cfd7ff}
#s12-l2 span{display:inline-block;color:#F4C430}
#s12-l3{left:60px;top:1070px;width:960px;font-size:104px}
</style>
<div class="s12-stars" id="s12-st1"></div><div class="s12-stars" id="s12-st2"></div>
<div id="s12-world">
  <div class="abs" id="s12-earth"></div>
  <div class="abs" id="s12-orbit"></div>
  <div class="abs" id="s12-sat"><img src="assets/sprites/rayquaza.png" alt="Rayquaza"><div id="s12-badge">SÉCURITÉ</div></div>
</div>
<div class="pix" id="s12-l1">LA DÉFENSE SPATIALE</div>
<div class="disp" id="s12-l2">Son <span id="s12-seul">seul</span> taf :</div>
<div class="disp" id="s12-l3">Surveiller le ciel</div>
@@@js
tl.fromTo("#s12-st1", { y: 0 }, { y: 160, duration: 5.15, ease: "none" }, 0);
tl.fromTo("#s12-st2", { y: 0 }, { y: 90, duration: 5.15, ease: "none" }, 0);
// la caméra monte dans l'espace
tl.fromTo("#s12-world", { y: 650 }, { y: 0, duration: 1.4, ease: "expo.out" }, 0);
// Rayquaza en orbite (ellipse inclinée)
const orb = { a: 0 };
const sat = document.getElementById("s12-sat");
const rot = (-12 * Math.PI) / 180;
const place = () => {
  const ex = Math.cos(orb.a) * 470, ey = Math.sin(orb.a) * 170;
  gsap.set(sat, { x: 540 + ex * Math.cos(rot) - ey * Math.sin(rot) - 140, y: 830 + ex * Math.sin(rot) + ey * Math.cos(rot) - 170, scale: 0.75 + 0.25 * (Math.sin(orb.a) + 1) / 2 });
};
place();
tl.fromTo(orb, { a: -0.4 }, { a: Math.PI * 2.2 - 0.4, duration: 5.15, ease: "none", onUpdate: place }, 0);
tl.fromTo("#s12-l1", { clipPath: "inset(0 100% 0 0)" }, { clipPath: "inset(0 0% 0 0)", duration: 0.5, ease: "steps(19)" }, W(58.2));
tl.fromTo("#s12-l2", { x: -700, opacity: 0 }, { x: 0, opacity: 1, duration: 0.35, ease: "expo.out" }, W(59.7));
tl.fromTo("#s12-seul", { scale: 1 }, { scale: 1.4, duration: 0.16, yoyo: true, repeat: 3, ease: "power2.out" }, W(59.96));
slam("#s12-l3", W(60.9), 2.4);

@@@ s13
@bg radial-gradient(circle at 50% 70%,#3a1d10,#0c0806 72%)
<style>
#s13-zoom{position:absolute;inset:0}
#s13-lbl{left:60px;top:420px;font-size:34px;color:#ffcf9a}
#s13-met{left:600px;top:380px;width:300px;height:300px}
#s13-streak{position:absolute;left:150px;top:120px;width:760px;height:60px;background:linear-gradient(90deg,#ffb36bcc,transparent);transform-origin:0 50%;transform:rotate(-52deg);border-radius:30px}
#s13-fire{position:absolute;inset:0;border-radius:50%;background:radial-gradient(#fff3b0,#ff7a1f 55%,transparent 72%)}
#s13-dx{position:absolute;left:60px;top:60px;width:180px;image-rendering:pixelated}
#s13-ray{left:0;top:600px;width:520px}
.s13-p{position:absolute;left:740px;top:520px;width:26px;height:26px;background:#ffcf4a;opacity:0}
#s13-boom{position:absolute;inset:0;background:#fff3d0;opacity:0}
#s13-cry{left:640px;top:960px;width:120px;filter:drop-shadow(0 0 22px #7fffd0)}
#s13-mark{left:540px;top:900px;width:320px;height:240px}
#s13-oub{left:560px;top:790px;font-size:90px;color:#F4C430}
</style>
<div class="cam" id="s13-cam"><div id="s13-zoom">
  <div class="pix" id="s13-lbl">DEOXYS N°1</div>
  <div class="abs" id="s13-met"><div id="s13-streak"></div><div id="s13-fire"></div><img id="s13-dx" src="assets/sprites/deoxys.png" alt="Deoxys"></div>
  <img class="px" id="s13-ray" src="assets/sprites/rayquaza.png" alt="Rayquaza">
  <div class="s13-p"></div><div class="s13-p"></div><div class="s13-p"></div><div class="s13-p"></div><div class="s13-p"></div><div class="s13-p"></div><div class="s13-p"></div>
  <div class="s13-p"></div><div class="s13-p"></div><div class="s13-p"></div><div class="s13-p"></div><div class="s13-p"></div><div class="s13-p"></div><div class="s13-p"></div>
  <svg class="abs" id="s13-cry" viewBox="0 0 20 30"><polygon points="10,0 20,12 10,30 0,12" fill="#7fffd0" stroke="#fff" stroke-width="1.2"/><polygon points="10,0 14,12 10,30 6,12" fill="#c8fff0" opacity=".7"/></svg>
  <svg class="abs" id="s13-mark" viewBox="0 0 320 240"><ellipse pathLength="1" cx="160" cy="120" rx="148" ry="106" fill="none" stroke="#F4C430" stroke-width="12" stroke-dasharray="1" stroke-dashoffset="1" transform="rotate(-8 160 120)"/></svg>
  <div class="disp" id="s13-oub">Oublié</div>
</div></div>
<div id="s13-boom"></div>
@@@js
tl.fromTo("#s13-lbl", { clipPath: "inset(0 100% 0 0)" }, { clipPath: "inset(0 0% 0 0)", duration: 0.4, ease: "steps(10)" }, W(62.3));
// la météorite tombe (flou de vitesse)
tl.fromTo("#s13-met", { x: 700, y: -900, filter: "blur(10px)" }, { x: 0, y: 0, filter: "blur(0px)", duration: W(63.84), ease: "power2.in" }, 0);
tl.fromTo("#s13-boom", { opacity: 0 }, { opacity: 0.8, duration: 0.05 }, W(63.84));
tl.to("#s13-boom", { opacity: 0, duration: 0.4 }, W(63.9));
shake("#s13-cam", W(63.84), 0.45, 26, 3);
tl.fromTo("#s13-fire", { scale: 1 }, { scale: 1.15, duration: 0.12, yoyo: true, repeat: 7, ease: "sine.inOut" }, W(63.9));
// Rayquaza le détruit
tl.fromTo("#s13-ray", { x: -700 }, { x: 0, duration: 0.35, ease: "expo.out" }, W(64.8));
tl.to("#s13-ray", { x: 140, duration: 0.15, yoyo: true, repeat: 1, ease: "power2.out" }, W(65.28));
tl.to("#s13-met", { scale: 1.8, opacity: 0, duration: 0.3, ease: "power2.out" }, W(65.4));
tl.fromTo("#s13-boom", { opacity: 0 }, { opacity: 0.9, duration: 0.05, immediateRender: false }, W(65.4));
tl.to("#s13-boom", { opacity: 0, duration: 0.5 }, W(65.46));
shake("#s13-cam", W(65.4), 0.5, 30, 5);
gsap.utils.toArray(".s13-p").forEach((p, i) => {
  const a = (i / 14) * Math.PI * 2 + hash(i) * 0.4, d = 280 + hash(i + 3) * 260;
  tl.fromTo(p, { x: 0, y: 0, opacity: 1, rotation: 0 }, { x: Math.cos(a) * d, y: Math.sin(a) * d, opacity: 0, rotation: 360 * hash(i + 7), duration: 0.8, ease: "power3.out" }, W(65.4));
});
// … mais oublie le cristal
pop("#s13-cry", W(66.24), 0.4);
tl.fromTo("#s13-cry", { rotation: -10 }, { rotation: 10, duration: 0.3, yoyo: true, repeat: 5, ease: "sine.inOut", immediateRender: false }, W(66.6));
tl.fromTo("#s13-zoom", { scale: 1, transformOrigin: "700px 1020px" }, { scale: 1.45, duration: 0.6, ease: "power3.inOut" }, W(66.72));
tl.to("#s13-mark ellipse", { strokeDashoffset: 0, duration: 0.35, ease: "power2.inOut" }, W(67.08));
tl.fromTo("#s13-oub", { scale: 0, rotation: -20, opacity: 0 }, { scale: 1, rotation: -6, opacity: 1, duration: 0.35, ease: "back.out(2.5)" }, W(67.3));

@@@ s14
@bg linear-gradient(#2a0d0d,#5a1a0a 66%,#1a0a06)
<style>
#s14-lbl{left:60px;top:420px;font-size:30px;color:#ffcf9a}
#s14-city{position:absolute;inset:0}
.s14-b{position:absolute;background:#1c0a0a repeating-linear-gradient(0deg,transparent 0 34px,#ffcf6b33 34px 46px);border-top:6px solid #3a1414}
#s14-dx{left:800px;top:500px;width:220px}
#s14-dxl{left:760px;top:460px;font-size:26px;color:#F4C430}
#s14-ray{left:160px;top:560px;width:640px}
.s14-line{position:absolute;left:0;width:1080px;height:8px;background:#ffffff66;opacity:0}
#s14-title{left:60px;top:430px;font-size:84px}
#s14-stamp{left:110px;top:1080px;font-size:130px;background:#1a0a06cc}
#s14-red{position:absolute;inset:0;background:#ff2a1a;opacity:0}
</style>
<div class="cam" id="s14-cam">
  <div class="pix" id="s14-lbl">QUELQUES ANNÉES PLUS TARD…</div>
  <div id="s14-city">
    <div class="s14-b" style="left:10px;top:900px;width:130px;height:380px"></div>
    <div class="s14-b" style="left:150px;top:760px;width:160px;height:520px"></div>
    <div class="s14-b" style="left:320px;top:960px;width:110px;height:320px"></div>
    <div class="s14-b" style="left:440px;top:820px;width:180px;height:460px"></div>
    <div class="s14-b" style="left:630px;top:930px;width:130px;height:350px"></div>
    <div class="s14-b" style="left:770px;top:780px;width:170px;height:500px"></div>
    <div class="s14-b" style="left:950px;top:880px;width:120px;height:400px"></div>
  </div>
  <div class="pix" id="s14-dxl">DEOXYS N°2</div>
  <img class="px" id="s14-dx" src="assets/sprites/deoxys-attaque.png" alt="Deoxys">
  <div class="s14-line" style="top:640px"></div><div class="s14-line" style="top:760px"></div><div class="s14-line" style="top:880px"></div><div class="s14-line" style="top:1000px"></div>
  <img class="px" id="s14-ray" src="assets/sprites/rayquaza.png" alt="Rayquaza">
  <div class="disp" id="s14-title">Larousse City</div>
  <div class="stamp" id="s14-stamp">Ravagée</div>
</div>
<div id="s14-red"></div>
@@@js
tl.fromTo("#s14-lbl", { clipPath: "inset(0 100% 0 0)" }, { clipPath: "inset(0 0% 0 0)", duration: 0.6, ease: "steps(26)" }, 0.05);
tl.fromTo("#s14-city", { y: 300 }, { y: 0, duration: 0.8, ease: "expo.out" }, 0);
pop("#s14-dx", W(69.92), 0.4);
pop("#s14-dxl", W(69.92), 0.3);
tl.fromTo("#s14-dx", { y: 0 }, { y: -20, duration: 0.25, yoyo: true, repeat: 3, ease: "sine.inOut", immediateRender: false }, W(70.32));
// Rayquaza arrive en furie
tl.fromTo("#s14-ray", { x: -1400, y: 500, rotation: -32, filter: "blur(18px)" }, { x: 0, y: 0, rotation: -14, filter: "blur(0px)", duration: 0.45, ease: "expo.out" }, W(71.12));
gsap.utils.toArray(".s14-line").forEach((l, i) => {
  tl.fromTo(l, { x: -1100, opacity: 0.9 }, { x: 1100, opacity: 0, duration: 0.35, ease: "power2.in" }, W(71.12) + i * 0.04);
});
tl.to(["#s14-dx", "#s14-dxl"], { x: 600, opacity: 0, duration: 0.3, ease: "power3.in" }, W(71.4));
tl.to("#s14-lbl", { opacity: 0, duration: 0.2 }, W(71.4));
shake("#s14-cam", W(71.5), 0.4, 22, 2);
// ravage
gsap.utils.toArray(".s14-b").forEach((b, i) => {
  tl.to(b, { y: 180 + hash(i) * 320, rotation: (hash(i + 5) * 2 - 1) * 22, duration: 0.6, ease: "power2.in" }, W(72.72) + i * 0.06);
});
shake("#s14-cam", W(72.72), 1.2, 30, 4);
tl.fromTo("#s14-red", { opacity: 0 }, { opacity: 0.55, duration: 0.05 }, W(72.72));
tl.to("#s14-red", { opacity: 0, duration: 0.5 }, W(72.8));
tl.fromTo("#s14-title", { x: -900, opacity: 0 }, { x: 0, opacity: 1, duration: 0.35, ease: "expo.out" }, W(73.1));
slam("#s14-stamp", W(73.7), 3, -7);
shake("#s14-cam", W(73.94), 0.3, 20, 8);

@@@ s15
@bg radial-gradient(circle at 50% 70%,#2a2f36,#0c0e10 72%)
<style>
#s15-ray{left:600px;top:1000px;width:360px}
#s15-t{left:60px;top:420px;font-size:150px}
.s15-r{position:absolute;width:150px;height:130px}
.s15-r svg{width:100%;height:100%;display:block}
</style>
<div class="cam" id="s15-cam">
  <img class="px" id="s15-ray" src="assets/sprites/rayquaza.png" alt="Rayquaza">
  <div class="disp" id="s15-t">Coincé.</div>
  <div id="s15-pile"></div>
</div>
<svg width="0" height="0" style="position:absolute"><defs><symbol id="s15-bot" viewBox="0 0 15 13" shape-rendering="crispEdges">
  <rect x="7" y="0" width="1" height="2" fill="#c9d1d9"/><rect x="3" y="2" width="9" height="5" fill="#8b949e"/><rect x="4" y="3" width="2" height="2" fill="#ff3b3b"/><rect x="9" y="3" width="2" height="2" fill="#ff3b3b"/>
  <rect x="1" y="7" width="13" height="6" fill="#6e7681"/><rect x="0" y="8" width="1" height="3" fill="#484f58"/><rect x="14" y="8" width="1" height="3" fill="#484f58"/><rect x="5" y="9" width="5" height="2" fill="#30363d"/>
</symbol></defs></svg>
@@@js
tl.fromTo("#s15-ray", { rotation: 26 }, { rotation: 34, duration: 0.2, yoyo: true, repeat: 13, ease: "sine.inOut" }, 0);
slam("#s15-t", W(75.4), 2.6);
// la pile de robots, rangée par rangée
const pile = document.getElementById("s15-pile");
const ROWS = [[6, 1150], [5, 1015], [4, 880], [3, 745], [2, 610]];
let k = 0;
ROWS.forEach(([n, y], r) => {
  const x0 = 540 - (n * 165) / 2 + 8 + r * 4;
  for (let i = 0; i < n; i++) {
    const d = document.createElement("div");
    d.className = "s15-r";
    d.id = "s15-r" + k;
    d.style.left = x0 + i * 165 + "px";
    d.style.top = y + (r === 4 ? 40 : 0) + "px";
    d.innerHTML = '<svg viewBox="0 0 15 13"><use href="#s15-bot"/></svg>';
    pile.appendChild(d);
    tl.fromTo(d, { y: -1600, rotation: (hash(k) * 2 - 1) * 20 }, { y: 0, rotation: (hash(k + 3) * 2 - 1) * 6, duration: 0.32, ease: "power3.in" }, W(75.8) + k * 0.065);
    k++;
  }
});
shake("#s15-cam", W(77.0), 0.5, 22, 6);

@@@ s16
@bg radial-gradient(circle at 50% 46%,#173f2c,#0B1F17 72%)
<style>
#s16-glow{position:absolute;inset:0;background:radial-gradient(circle at 50% 46%,#ffffff 0,#d8fff0 16%,#1e8a55 42%,#0B1F17 72%);opacity:0}
#s16-q{left:60px;top:660px;width:960px;font-size:84px}
.s16-dx{position:absolute;top:380px;width:240px;image-rendering:pixelated}
#s16-ray{left:290px;top:940px;width:500px}
#s16-chen{left:350px;top:890px;width:380px;opacity:0}
.s16-r{position:absolute;width:170px;height:147px}
.s16-r svg{width:100%;height:100%;display:block}
#s16-flash{position:absolute;inset:0;background:#fff;opacity:0}
</style>
<div id="s16-glow"></div>
<div class="cam" id="s16-cam">
  <img class="s16-dx" src="assets/sprites/deoxys.png" style="left:20px" alt="Deoxys">
  <img class="s16-dx" src="assets/sprites/deoxys-attaque.png" style="left:280px" alt="Deoxys Attaque">
  <img class="s16-dx" src="assets/sprites/deoxys-defense.png" style="left:540px" alt="Deoxys Défense">
  <img class="s16-dx" src="assets/sprites/deoxys-vitesse.png" style="left:800px" alt="Deoxys Vitesse">
  <div class="disp" id="s16-q">Qui vient le sauver ?</div>
  <img class="px" id="s16-ray" src="assets/sprites/rayquaza.png" alt="Rayquaza">
  <img class="px" id="s16-chen" src="assets/sprites/chenipan.png" alt="Chenipan">
  <div id="s16-pile"></div>
</div>
<svg width="0" height="0" style="position:absolute"><defs><symbol id="s16-bot" viewBox="0 0 15 13" shape-rendering="crispEdges">
  <rect x="7" y="0" width="1" height="2" fill="#c9d1d9"/><rect x="3" y="2" width="9" height="5" fill="#8b949e"/><rect x="4" y="3" width="2" height="2" fill="#ff3b3b"/><rect x="9" y="3" width="2" height="2" fill="#ff3b3b"/>
  <rect x="1" y="7" width="13" height="6" fill="#6e7681"/><rect x="0" y="8" width="1" height="3" fill="#484f58"/><rect x="14" y="8" width="1" height="3" fill="#484f58"/><rect x="5" y="9" width="5" height="2" fill="#30363d"/>
</symbol></defs></svg>
<div id="s16-flash"></div>
@@@js
// la pile de robots recouvre encore Rayquaza
const pile = document.getElementById("s16-pile");
const SPOTS = [[200, 1120], [370, 1100], [540, 1110], [710, 1120], [280, 980], [450, 970], [620, 980], [370, 850], [540, 860]];
const bots = SPOTS.map(([x, y], i) => {
  const d = document.createElement("div");
  d.className = "s16-r";
  d.style.left = x + "px";
  d.style.top = y + "px";
  d.innerHTML = '<svg viewBox="0 0 15 13"><use href="#s16-bot"/></svg>';
  pile.appendChild(d);
  return d;
});
tl.fromTo("#s16-q", { scale: 1.5, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.3, ease: "power4.out" }, W(78.7));
tl.to("#s16-q", { opacity: 0, y: -40, duration: 0.25 }, W(80.8));
// les Deoxys arrivent en formation
gsap.utils.toArray(".s16-dx").forEach((d, i) => {
  tl.fromTo(d, { y: -900 }, { y: 0, duration: 0.45, ease: "back.out(1.5)" }, W(79.9) + i * 0.1);
  tl.fromTo(d, { y: 0 }, { y: -18, duration: 0.4, yoyo: true, repeat: 9, ease: "sine.inOut", immediateRender: false }, W(80.5) + i * 0.08);
});
// … et le sortent des robots
bots.forEach((b, i) => {
  const dir = SPOTS[i][0] < 540 ? -1 : 1;
  tl.to(b, { x: dir * (700 + hash(i) * 300), y: -900 - hash(i + 2) * 500, rotation: dir * 360 * hash(i + 4), duration: 0.6, ease: "power2.in" }, W(80.9) + i * 0.04);
});
tl.fromTo("#s16-ray", { y: 0 }, { y: -180, duration: 0.6, ease: "back.out(1.6)" }, W(81.2));
// PV 0 → K.O.
tl.to("#s16-ray", { y: -110, duration: 0.3, ease: "power2.in" }, G(82.5));
tl.fromTo("#s16-ray", { opacity: 1 }, { opacity: 0.35, duration: 0.07, yoyo: true, repeat: 5, ease: "none" }, G(82.5));
tl.to(".s16-dx", { opacity: 0.35, duration: 0.6 }, G(83.4));
// anti-évolution : silhouette blanche qui alterne Rayquaza / Chenipan
tl.to("#s16-glow", { opacity: 1, duration: 0.8, ease: "power2.inOut" }, G(83.4));
tl.to("#s16-ray", { filter: "brightness(0) invert(1)", duration: 0.4 }, G(83.6));
tl.set("#s16-chen", { filter: "brightness(0) invert(1)" }, G(83.6));
const SWAPS = [84.0, 84.35, 84.65, 84.9, 85.1, 85.26, 85.38, 85.48, 85.56, 85.62];
SWAPS.forEach((t, i) => {
  const chen = i % 2 === 0;
  tl.set("#s16-ray", { opacity: chen ? 0 : 1 }, G(t));
  tl.set("#s16-chen", { opacity: chen ? 1 : 0 }, G(t));
});
tl.set("#s16-ray", { opacity: 0 }, G(85.66));
tl.set("#s16-chen", { opacity: 1 }, G(85.66));
tl.fromTo("#s16-flash", { opacity: 0 }, { opacity: 1, duration: 0.05 }, G(85.64));
tl.to("#s16-flash", { opacity: 0, duration: 0.3, ease: "power2.out" }, G(85.7));
tl.set("#s16-chen", { filter: "brightness(1) invert(0)" }, G(85.68));
tl.to("#s16-glow", { opacity: 0.25, duration: 0.25 }, G(85.7));
tl.fromTo("#s16-chen", { scale: 1 }, { scale: 1.35, duration: 0.35, ease: "back.out(3)", immediateRender: false }, G(85.7));
tl.to("#s16-chen", { y: -120, duration: 0.4, ease: "power2.out" }, G(85.75));
// BOUCLE : Chenipan se remet à briller (il ré-évolue…) et l'écran finit tout blanc.
// La vidéo repart d'un écran blanc d'où Rayquaza surgit : le raccord ressemble à une évolution.
tl.to("#s16-chen", { filter: "brightness(0) invert(1)", duration: 0.25, ease: "power1.in" }, G(85.95));
tl.to("#s16-chen", { scale: 3.4, duration: 0.45, ease: "power3.in" }, G(85.95));
