@@@ s01
@bg radial-gradient(circle at 50% 960px,#8a1c26 0,#3e0a12 45%,#0d0306 100%)
<style>
#s01-stars{position:absolute;inset:0}
#s01-hud{left:340px;top:150px;width:400px;height:150px;opacity:0;text-align:center;font-size:120px;color:#7fe8ff;text-shadow:0 0 24px #39c8ff,6px 6px 0 #0b1020}
</style>
<div id="s01-stars"></div>
<div class="cam" id="s01-cam">
  <div class="clock" id="s01-clock"><img class="face" src="assets/sprites/horloge.png" alt=""><img class="hand h-heure" src="assets/sprites/aiguille-heure.png" alt=""><img class="hand h-minute" src="assets/sprites/aiguille-minute.png" alt=""><img class="hand h-seconde" src="assets/sprites/aiguille-seconde.png" alt=""></div>
</div>
<div class="pix" id="s01-hud">20:00</div>
<div class="vignette"></div>
@@@js
// raccord de boucle : même cadrage que la toute fin (horloge à 11 h 40, zoom qui continue d'avancer)
motes(document.getElementById("s01-stars"), 40, 3, [0, 0, 1080, 1920], "star");
gsap.utils.toArray("#s01-stars .star").forEach((el, i) => gsap.set(el, { position: "absolute", width: 6, height: 6, background: "#ffb8a8", opacity: 0.3 + hash(i) * 0.6 }));
const setClock = clockSet(document.getElementById("s01-clock"));
drive(0, 4.0, (t) => setClock(-20 + Math.floor(t) / 60));
tl.fromTo("#s01-cam", { scale: 1 }, { scale: 1.12, duration: 4.0, ease: "none", transformOrigin: "540px 960px" }, 0);
// C'est le temps qu'il te reste : compte à rebours façon HUD
tl.fromTo("#s01-hud", { opacity: 0, scale: 1.6 }, { opacity: 1, scale: 1, duration: 0.25, ease: "back.out(2)" }, W(1.18));
drive(W(1.18), 4.0 - W(1.18), (t) => { document.getElementById("s01-hud").textContent = t < 1.2 ? "20:00" : "19:5" + (9 - Math.min(9, Math.floor(t - 1.2))); });
shake("#s01-hud", W(3.15), 0.25, 8, 2);

@@@ s02
@bg #0d0306
<style>
#s02-cam{transform-origin:540px 960px}
</style>
<div class="cam" id="s02-cam">
  <div class="clock" id="s02-clock"><img class="face" src="assets/sprites/horloge.png" alt=""><img class="hand h-heure" src="assets/sprites/aiguille-heure.png" alt=""><img class="hand h-minute" src="assets/sprites/aiguille-minute.png" alt=""><img class="hand h-seconde" src="assets/sprites/aiguille-seconde.png" alt=""></div>
</div>
<div class="flash" id="s02-flash"></div>
<div class="vignette"></div>
@@@js
// Tic. Tac. : deux gros plans secs sur l'aiguille des secondes
const setClock = clockSet(document.getElementById("s02-clock"));
setClock(-20 + 4 / 60);
tl.set("#s02-cam", { scale: 3.2, x: 0, y: 900, rotation: 0 }, 0);
tl.set("#s02-clock .h-seconde", { rotation: 24 }, W(4.08));
tl.fromTo("#s02-flash", { opacity: 0.6 }, { opacity: 0, duration: 0.25 }, W(4.08));
shake("#s02-cam", W(4.08), 0.2, 16, 1);
tl.set("#s02-cam", { scale: 4.2, x: -260, y: -700, rotation: -8 }, W(4.99));
tl.set("#s02-clock .h-seconde", { rotation: 30 }, W(4.99));
tl.fromTo("#s02-flash", { opacity: 0.6 }, { opacity: 0, duration: 0.2, immediateRender: false }, W(4.99));

@@@ s03
@bg #2c5a30
<style>
#s03-dlg{left:60px;top:150px;width:960px;height:190px;opacity:0;font-size:52px;line-height:1.35;color:#3a2410;text-transform:none;background:#f4e6c4;border:8px solid #6b4220;border-radius:22px;box-shadow:0 10px 0 #00000066,inset 0 0 0 5px #c9a26a;padding:26px 34px}
#s03-dlg b{position:absolute;left:30px;top:-46px;font-weight:400;font-size:40px;background:#6b4220;color:#ffe9b8;padding:4px 18px;border-radius:10px}
.note{position:absolute;font-family:"Pixel";font-size:70px;color:#fff6c4;text-shadow:4px 4px 0 #2c5a30;opacity:0}
</style>
<div class="sky"></div>
<div class="stage" id="s03-stage"><div class="world" id="s03-world"><div class="ground" id="s03-ground"></div>
  <div class="spr bb" id="s03-t1"></div><div class="spr bb" id="s03-t2"></div><div class="spr bb" id="s03-t3"></div>
</div></div>
<div class="rays" id="s03-rays"></div>
<div id="s03-motes"></div>
<div id="s03-notes"></div>
<div class="pix" id="s03-dlg"><b>Arbre</b></div>
<div class="vignette"></div>
@@@js
// T'es un petit Sadida, au fond de la forêt : on marche, tout est vivant
const T = ["s03-t1", "s03-t2", "s03-t3"].map((id) => document.getElementById(id));
const face = T.map((el) => still(el, "arbre-sadida", 1));
face.forEach((f) => f(2, 0)); // yeux fermés au début
const trees = [{ el: T[0], x: -300, z: -1000 }, { el: T[1], x: 320, z: -1150 }, { el: T[2], x: -340, z: -1450 }];
const props = forest("s03-world", 18, 3, -200, 300, 420, 460, 420).concat(trees);
const up = world("#s03-ground", props);
const D = 7.25;
drive(0, D, (t) => {
  // ils rigolent : les arbres sautillent
  const hop = t > W(9.98) && t < W(10.9) ? -Math.abs(Math.sin((t - W(9.98)) * 14)) * 40 : 0;
  trees.forEach((p, i) => { p.dy = hop * (i === 1 ? 0.7 : 1); });
  up(900 * t / D);
});
bob("#s03-world", 0, D, 10, 0.6);
// wakfu dans l'air : petites lucioles bleu-vert qui flottent
const ms = motes(document.getElementById("s03-motes"), 22, 5, [40, 200, 1000, 1000]);
ms.forEach((m, i) => tl.fromTo(m, { y: 0, opacity: 0.2 }, { y: -160 - hash(i) * 200, opacity: 1, duration: D, ease: "sine.inOut" }, 0));
tl.fromTo("#s03-rays", { opacity: 0.6 }, { opacity: 1, duration: D / 2, yoyo: true, repeat: 1, ease: "sine.inOut" }, 0);
// Ici, les arbres parlent : ils ouvrent les yeux
T.forEach((el, i) => face[i](0, W(7.66) + i * 0.12));
// Ils chantent : la bouche s'ouvre et se ferme, des notes s'envolent
for (let k = 0; k < 6; k++) T.forEach((el, i) => face[i](k % 2 ? 0 : 1, W(8.85) + k * 0.18 + i * 0.05));
T.forEach((el, i) => face[i](0, W(9.95)));
const notes = document.getElementById("s03-notes");
[[300, 700], [720, 640], [180, 820], [820, 760], [460, 600]].forEach(([x, y], i) => {
  const n = document.createElement("div"); n.className = "note"; n.textContent = i % 2 ? "♫" : "♪";
  n.style.left = x + "px"; n.style.top = y + "px"; notes.appendChild(n);
  tl.fromTo(n, { opacity: 0, y: 40 }, { opacity: 1, y: -120, duration: 0.9, ease: "power1.out" }, W(8.9) + i * 0.16);
  tl.to(n, { opacity: 0, duration: 0.25 }, W(8.9) + i * 0.16 + 0.9);
});
// ils rigolent : bouches ouvertes en rafale
for (let k = 0; k < 4; k++) T.forEach((el, i) => face[i](k % 2 ? 0 : 1, W(10.0) + k * 0.12));
T.forEach((el, i) => face[i](0, W(10.5)));
// ils te racontent des histoires : bulle de dialogue
tl.fromTo("#s03-dlg", { opacity: 0, y: -40 }, { opacity: 1, y: 0, duration: 0.25, ease: "back.out(2)" }, W(10.6));
typeText(document.getElementById("s03-dlg"), "Il était une fois, une forêt qui chantait…", W(10.75), W(11.95));

@@@ s04
@bg #2c5a30
<style>
#s04-glint{left:540px;top:640px;width:60px;height:60px;opacity:0;background:radial-gradient(#ffffff,#7fe8ff 40%,transparent 70%)}
</style>
<div id="s04-all">
<div class="sky"></div>
<div class="stage" id="s04-stage"><div class="world" id="s04-world"><div class="ground" id="s04-ground"></div>
  <div class="spr bb" id="s04-t1"></div><div class="spr bb" id="s04-t2"></div><div class="spr bb" id="s04-t3"></div>
</div></div>
<div class="rays" id="s04-rays"></div>
</div>
<div class="abs" id="s04-glint"></div>
<div class="vignette"></div>
@@@js
// Sauf qu'aujourd'hui… ils se taisent.
const T = ["s04-t1", "s04-t2", "s04-t3"].map((id) => document.getElementById(id));
const face = T.map((el) => still(el, "arbre-sadida", 1));
const trees = [{ el: T[0], x: -300, z: -1000 }, { el: T[1], x: 320, z: -1150 }, { el: T[2], x: -340, z: -1450 }];
const props = forest("s04-world", 18, 3, -200, 300, 420, 460, 420).concat(trees);
const up = world("#s04-ground", props);
drive(0, 3.05, (t) => up(900 + 140 * Math.min(1, t / 1.2) ** 0.5));
T.forEach((el, i) => face[i](0, 0));
T.forEach((el, i) => face[i](2, W(13.6) + i * 0.15));
tl.fromTo("#s04-all", { filter: "saturate(1) brightness(1)" }, { filter: "saturate(0.55) brightness(0.72)", duration: 1.4, ease: "power1.inOut" }, W(13.3));
tl.to("#s04-rays", { opacity: 0, duration: 1.0 }, W(13.3));
// Tic. Tac. : la caméra sursaute, un reflet métallique au loin
shake("#s04-stage", W(14.19), 0.18, 12, 3);
shake("#s04-stage", W(14.9), 0.18, 12, 4);
tl.fromTo("#s04-glint", { opacity: 0, scale: 0.3 }, { opacity: 1, scale: 1.4, duration: 0.15, yoyo: true, repeat: 1 }, W(14.95));
